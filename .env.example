PERKUTUT_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/perkututcup
# Link undangan grup WhatsApp peserta (opsional; tombol disembunyikan bila kosong)
PERKUTUT_WHATSAPP_URL=

# Superkutut (god-mode) — ganti sebelum produksi!
PERKUTUT_SUPERADMIN_USER=superkutut
PERKUTUT_SUPERADMIN_PASSWORD=admin
# Secret TOTP base32 (A-Z2-7), panjang kelipatan 8, min 16 char (>=112 bit).
# Contoh mudah diingat (32 char): GILAKAMUKAMUYANGGILAAKUSALAHAPA (padding = otomatis ditambah server)
# Generate QR/entry manual di https://totp.danhersam.com/#/ lalu scan ke authenticator.
PERKUTUT_SUPERADMIN_TOTP_SECRET=
# Retensi audit log (hari)
PERKUTUT_AUDIT_RETENTION_DAYS=180
